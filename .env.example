# Canonical production URL, used in metadata, JSON-LD, and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.zhenupdigital.com

# Optional: where consultation form submissions get forwarded (Slack
# incoming webhook, Supabase Edge Function, Zapier/Make, email API, etc).
# If unset, submissions are only logged server-side.
LEAD_WEBHOOK_URL=

# Optional: your Calendly scheduling link (e.g.
# https://calendly.com/your-handle/consultation). If unset, the booking flow
# falls back to a "we'll be in touch" confirmation instead of a live calendar.
NEXT_PUBLIC_CALENDLY_URL=
